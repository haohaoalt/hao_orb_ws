      Shaft Length: 0.10000000149011612
      Topic: /orbslam2/camera_path
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /orb/frame
      Max Value: 1
      Median window: 5
