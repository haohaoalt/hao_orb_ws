<?xml version="1.0" encoding="UTF-8"?>
<launch>
<!-- setup arguments -->
<arg name="sequence" default="V1_01_easy"/>

<!-- rosbag arguments -->
<arg name="bag_data_path" default="/media/ylsdb20/Friday/dataset/EuRoc/$(arg sequence).bag"/>

<!-- ORBSLAM arguments -->
<arg name="octomap_enabled" default="false"/>

<arg name="orb_settings_file"   default="$(find orb_slam2_ros)/settings/EuRoC.yaml"/>

<!-- ORBSLAM2 with Ros -->
<!-- Provide the correct settings .yaml file to specify camera parameters and ORB feature settings -->
<node pkg="orb_slam2_ros" type="Stereo_euroc" name="orb_slam2" args="$(find orb_slam2_lib)/Vocabulary/ORBvoc.bin $(arg orb_settings_file) true $(arg sequence)" cwd="node" output="screen">
   <param name="octomap_enabled_" type="bool" value="$(arg octomap_enabled)"/>
   <!-- needed for projected/gradient map-->
   <param name="octomap_resolution" value="0.2"/>
   <param name="occupancy_projection_min_height" value="-0.1"/>
   <param name="occupancy_gradient_max_height" value="0.2"/>
   <param name="occupancy_gradient_nb_erosions" value="1"/>
   <param name="occupancy_gradient_low_slope" value="0.3"/>
   <param name="occupancy_gradient_high_slope" value="0.5"/>
</node>

<!-- tf -->
<node pkg = "tf" type = "static_transform_publisher" name = "baselink_to_camera" args="0.19 0.0 0.2 0.0 0.0 0.0 baselink /orbslamex/camera 40" />

<!-- rosbag replay-->
<param name="use_sim_time" value="true"/>
<node pkg="rosbag" type="play" name="player" output="log" args="$(arg bag_data_path) --clock -r 1"></node>

<!-- feature visualizer arguments -->
<arg name="visualize_orb_features" default="true"/>
<node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" args="image:=/orbslamex/frame" if="$(arg visualize_orb_features)" output="screen"/>

<!-- rviz -->
<!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find orb_slam2_ros)/rviz/euroc.rviz" /> -->

</launch>
