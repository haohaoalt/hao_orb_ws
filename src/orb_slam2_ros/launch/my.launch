<launch>
    <node name="gps_to_rviz" pkg="orb_slam2_ros" type="gps_to_rviz" output="screen" />
    <!-- setup arguments -->
    <arg name="sequence" default="zed_1f_loop_gnss"/>
    <!-- rosbag replay-->
    <param name="use_sim_time" value="true"/>
    <node pkg="rosbag" type="play" name="play" output="log" args="--clock /media/ylsdb20/Friday/dataset/Sensors/GNSS-IMU/zed_1f_loop_gnss.bag"/>
    <!-- ORBSLAM2 launch -->
    <arg name="orb_settings_file" default="$(find orb_slam2_ros)/settings/zed2i640.yaml"/>
    <!-- ORBSLAM2 with Ros -->
    <!-- Provide the correct settings .yaml file to specify camera parameters and ORB feature settings -->
    <node pkg="orb_slam2_ros" type="Stereo" name="orb_slam2" args="$(find orb_slam2_lib)/Vocabulary/ORBvoc.bin $(arg orb_settings_file) False $(arg sequence)" cwd="node" output="screen">
        <param name="octomap_enabled_" value="true"/>
        <!-- needed for projected/gradient map-->
        <param name="octomap_resolution" value="0.2"/>
        <param name="occupancy_projection_min_height" value="-0.1"/>
        <param name="occupancy_gradient_max_height" value="0.2"/>
        <param name="occupancy_gradient_nb_erosions" value="1"/>
        <param name="occupancy_gradient_low_slope" value="0.3"/>
        <param name="occupancy_gradient_high_slope" value="0.5"/>
    </node>

    <!-- tf -->
    <node pkg = "tf" type = "static_transform_publisher" name = "baselink_to_camera" args="0.19 0.0 0.2 0.0 0.0 0.0 baselink /orbslamex/frame 40" />

    <!-- rviz -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find orb_slam2_ros)/rviz/gps_path.rviz" /> -->
    <arg name="visualize_orb_features" default="true"/>
<node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" args="image:=/orbslamex/frame" if="$(arg visualize_orb_features)"/>
</launch>
